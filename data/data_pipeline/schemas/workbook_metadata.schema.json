{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workbook Metadata Schemas",
  "description": "S1结构解析产出的四份元数据schema",
  "definitions": {
    "workbook_map": {
      "type": "object",
      "required": ["workbook_id", "sheets"],
      "properties": {
        "workbook_id": {"type": "string"},
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "used_range"],
            "properties": {
              "name": {"type": "string"},
              "role": {
                "type": "string",
                "enum": ["input", "calculation", "output", "control", "summary", "hidden", "unknown"]
              },
              "used_range": {"type": "string"},
              "header_row": {"type": "integer"},
              "header_col": {"type": "integer"},
              "time_axis": {
                "type": "object",
                "properties": {
                  "direction": {"enum": ["horizontal", "vertical"]},
                  "start_col": {"type": "string"},
                  "end_col": {"type": "string"},
                  "historical_end": {"type": "string"},
                  "forecast_start": {"type": "string"}
                }
              },
              "unit": {"type": "string"},
              "regions": {
                "type": "object",
                "properties": {
                  "input_area": {"type": "array", "items": {"type": "string"}},
                  "formula_area": {"type": "array", "items": {"type": "string"}},
                  "output_area": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        }
      }
    },
    "formula_graph": {
      "type": "object",
      "required": ["workbook_id", "cells", "edges"],
      "properties": {
        "workbook_id": {"type": "string"},
        "cells": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "formula": {"type": "string"},
              "r1c1_normalized": {"type": "string"},
              "formula_family_id": {"type": "string"},
              "is_hardcoded": {"type": "boolean"},
              "precedents": {"type": "array", "items": {"type": "string"}},
              "dependents": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "cross_sheet": {"type": "boolean"}
            }
          }
        },
        "formula_families": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "r1c1_pattern": {"type": "string"},
              "member_cells": {"type": "array", "items": {"type": "string"}},
              "propagation_direction": {"enum": ["horizontal", "vertical", "both"]}
            }
          }
        },
        "broken_references": {
          "type": "array",
          "items": {"type": "string"}
        },
        "hardcoded_constants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cell": {"type": "string"},
              "value": {}
            }
          }
        }
      }
    },
    "style_map": {
      "type": "object",
      "required": ["workbook_id", "styles"],
      "properties": {
        "workbook_id": {"type": "string"},
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "number_format": {"type": "string"},
              "font_color": {"type": "string"},
              "fill_color": {"type": "string"},
              "border": {"type": "object"},
              "is_merged": {"type": "boolean"},
              "merge_range": {"type": "string"}
            }
          }
        },
        "merged_regions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "named_ranges": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "invariants": {
      "type": "object",
      "required": ["workbook_id", "checks"],
      "properties": {
        "workbook_id": {"type": "string"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "cell", "expected"],
            "properties": {
              "name": {"type": "string"},
              "type": {
                "enum": [
                  "balance_sheet_balance",
                  "three_statement_tie",
                  "sum_equals_total",
                  "ratio_consistency",
                  "unit_scale_relation"
                ]
              },
              "cell": {"type": "string"},
              "related_cells": {"type": "array", "items": {"type": "string"}},
              "expected": {"type": "string"},
              "tolerance": {"type": "number", "default": 0.01},
              "rationale": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
